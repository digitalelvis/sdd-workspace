    "defaultRules": ["engineering-rules", "node-rules"],
    "linterDependencies": ["eslint@8.56.0", "prettier@3.1.0"]
  },
  "react": {
    "defaultSkills": ["spec-driven", "react-best-practices", "react-ui-patterns"],
