{
  "name": "ai-sdd-workspace",
  "version": "0.0.1",
  "description": "AI - SDD Enginee for Workspaces",
  "main": "dist/index.js",
  "bin": {
    "sdd": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "format": "prettier --write 'src/**/*.{js,ts,json,md}'"
  },
  "files": [
    "dist",
    "src/templates"
  ],
  "keywords": [
    "sdd",
    "ai",
    "workspace",
    "boilerplate",
    "generator",
    "spec-kit"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "inquirer": "^9.2.12"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.0",
    "eslint": "^8.56.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
